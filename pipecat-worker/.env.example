# ============================================================
# CommuniQ Pipecat Worker — environment variables
# Copy to .env and adjust for your machine.
# ============================================================

# ── LiveKit (must match livekit/livekit.yaml + Node .env) ───
# NEVER reuse this repo's example/dev secret in production — generate a fresh
# strong random secret (>= 32 chars) and inject it via your hosting platform's
# secret store instead of committing it anywhere.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ── LLM backend for the LIVE pipeline (bot.py) ──────────────
# groq (default) = GroqLLMService, qwen/qwen3.8-27b.
# openai_compat  = swap ONLY the conversational LLM for any OpenAI-compatible
#                  endpoint below (local Ollama serving the fine-tuned model,
#                  a Modal-hosted vLLM server, etc.) — STT/TTS stay as-is.
#                  Mirrors ai-server's LLM_BACKEND naming for consistency.
LLM_BACKEND=groq
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=communiq:8b
OPENAI_COMPAT_API_KEY=not-needed

# ── Local pipeline (agent.py) — separate, currently-unwired path ──
# agent.py is a full local STT+LLM+TTS pipeline (faster-whisper/Ollama/Kokoro),
# not the live one above. Only relevant if you switch main.py to run it instead
# of bot.py — see requirements.txt's commented-out local-model deps.
# ~4GB VRAM (e.g. RTX 2050 Laptop): prefer base/small whisper model + int8; if
# OOM, try tiny or WHISPER_DEVICE=cpu. Match CUDA driver to ctranslate2 wheel
# (see /health cp3_stack).
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8
KOKORO_VOICE=af_heart

# Fallback system prompt if Node omits system_prompt (should not happen).
DEFAULT_SYSTEM_PROMPT=You are a professional AI conversation partner helping users practice spoken English.

# ── Worker HTTP server ─────────────────────────────────────
PORT=9000

# ── Firestore transcript sync (optional, for /sessions/end evaluation) ──
# Same PIPECAT_WEBHOOK_SECRET as server/.env. Node URL reachable from this machine.
# NOTE: this secret is now used in BOTH directions:
#   - outbound: sent as the X-Communiq-Worker-Secret header when this worker
#     POSTs turns/crash-notifications to the Node backend.
#   - inbound: REQUIRED as the X-Communiq-Worker-Secret header on calls to
#     POST /start-agent (and DELETE /bots/{id} / POST /stop-agent) — the Node
#     backend's dispatchAgent call must send it or those calls will get 401.
NODE_INTERNAL_URL=http://127.0.0.1:3000
PIPECAT_WEBHOOK_SECRET=change-me-to-a-long-random-string-at-least-16-chars

# ── Session safety limits ──────────────────────────────────────────────────
# Hard wall-clock cap (seconds) on a single live-voice session, enforced
# regardless of participant activity — protects against unbounded Groq/local
# STT+LLM usage if a client never cleanly disconnects. Default: 30 minutes.
PIPECAT_MAX_SESSION_SECONDS=1800
