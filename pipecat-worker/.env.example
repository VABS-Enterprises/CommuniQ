# ============================================================
# CommuniQ Pipecat Worker — environment variables
# Copy to .env and adjust for your machine.
# ============================================================

# ── LiveKit (must match livekit/livekit.yaml + Node .env) ───
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=communiq-local-dev-livekit-secret-min-32ch

# ── Local STT — faster-whisper (CTranslate2) ─────────────────
# Model sizes: tiny, base, small, medium, large-v3, ...
# ~4GB VRAM (e.g. RTX 2050 Laptop): prefer base or small + int8; if OOM, try tiny
# or WHISPER_DEVICE=cpu. Match CUDA driver to ctranslate2 wheel (see /health cp3_stack).
WHISPER_MODEL=small
# cuda | cpu
WHISPER_DEVICE=cuda
# int8 is a good default for GPU; on CPU use int8 or float32
WHISPER_COMPUTE_TYPE=int8

# ── Local TTS — Kokoro ─────────────────────────────────────
KOKORO_VOICE=af_heart

# ── LLM — Ollama (laptop) or vLLM (Linux + CUDA server) ────
# Pull model first: ollama pull llama3.2:3b
# VRAM: keep one small model loaded during live sessions; watch nvidia-smi + worker logs
# (Local ASR / Kokoro wall_ms=...) while tuning.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
# After CP4: ollama create communiq:8b → set LLM_MODEL=communiq:8b

# Fallback system prompt if Node omits system_prompt (should not happen).
DEFAULT_SYSTEM_PROMPT=You are a professional AI conversation partner helping users practice spoken English.

# ── Worker HTTP server ─────────────────────────────────────
PORT=9000

# ── Firestore transcript sync (optional, for /sessions/end evaluation) ──
# Same PIPECAT_WEBHOOK_SECRET as server/.env. Node URL reachable from this machine.
NODE_INTERNAL_URL=http://127.0.0.1:3000
PIPECAT_WEBHOOK_SECRET=change-me-to-a-long-random-string-at-least-16-chars
