{
  "name": "communiq-backend",
  "version": "1.0.0",
  "description": "CommuniQ Node.js backend — real-time voice AI practice platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "eval-model:seed": "node src/scripts/seedSyntheticEvaluationHistory.js",
    "eval-model:seed:cleanup": "node src/scripts/seedSyntheticEvaluationHistory.js --cleanup",
    "eval-model:simulate": "node src/scripts/simulateConvergence.js",
    "levels:sync": "node src/scripts/syncLevels.js",
    "levels:check": "node src/scripts/syncLevels.js --check",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.2.0",
    "form-data": "^4.0.5",
    "helmet": "^8.0.0",
    "livekit-server-sdk": "^2.15.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
