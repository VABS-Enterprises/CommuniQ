# ─── Firebase ────────────────────────────────────────────────────────────────
# Path to your Firebase Admin SDK service account JSON key.
# Download from Firebase Console → Project Settings → Service Accounts.
GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-service-account.json

# Your Firebase project ID (found in Firebase Console → Project Settings).
FIREBASE_PROJECT_ID=your-project-id

# ─── AI Server ────────────────────────────────────────────────────────────────
# Base URL of the FastAPI ai-server.
# Local development: http://localhost:8000
# Exposed via ngrok: https://xxxx.ngrok.io
FASTAPI_URL=http://localhost:8000

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Node server listens on.
PORT=3000

# Node environment — controls morgan log format and other env-aware behaviour.
# Use "production" on any deployed instance.
NODE_ENV=development

# ─── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Leave unset (or empty) to allow all origins in development.
# Example: https://app.communiq.in,https://admin.communiq.in
ALLOWED_ORIGINS=

# Secret header value required for admin-only endpoints (POST /scenarios).
# Set to a long random string — treat it like a password.
ADMIN_SECRET=change-me-to-a-long-random-secret
