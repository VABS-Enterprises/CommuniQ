# CommuniQ — Node.js Server Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download JSON → extract the 3 fields below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# Copy the private_key value from the JSON exactly — keep the \n characters as-is
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── FastAPI AI Server ─────────────────────────────────────────────────────────
# Internal URL of the FastAPI server — never exposed to Flutter.
# Local dev: http://localhost:8000
# Render: use the full URL https://your-ai-service.onrender.com
# If Render "fromService" gives only a hostname (no scheme), the server prepends https://
FASTAPI_URL=http://localhost:8000

# ─── LiveKit (CP2 — live voice mode) ──────────────────────────────────────────
# Set LIVEKIT_ENABLED=true to activate WebRTC live voice mode.
# Leave false (default) to keep using the classic HTTP turn-based mode.
#
# Dev (laptop):
#   LIVEKIT_URL=ws://localhost:7880   (or ws://<LAN-IP>:7880 for phone on same Wi-Fi)
#   LIVEKIT_API_KEY=devkey (must match livekit/livekit.yaml keys)
#   LIVEKIT_API_SECRET=communiq-local-dev-livekit-secret-min-32ch
#   (LiveKit 1.10+ requires secret >= 32 characters)
#
# Production (VPS):
#   LIVEKIT_URL=wss://livekit.yourdomain.com
#   LIVEKIT_API_KEY=<strong-random-key>
#   LIVEKIT_API_SECRET=<strong-random-secret>
LIVEKIT_ENABLED=false
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=communiq-local-dev-livekit-secret-min-32ch

# URL of the Pipecat agent worker (CP2).
# Dev: http://localhost:9000   Production: http://pipecat-worker:9000 (Docker) or VPS URL
PIPECAT_WORKER_URL=http://localhost:9000

# Shared secret for Pipecat → POST /sessions/internal/live-voice-turn (transcript sync).
# Must match pipecat-worker/.env PIPECAT_WEBHOOK_SECRET (>= 16 characters).
PIPECAT_WEBHOOK_SECRET=change-me-to-a-long-random-string-at-least-16-chars

# ─── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Leave unset (or empty) to allow all origins in development.
# Example: https://app.communiq.in,https://admin.communiq.in
ALLOWED_ORIGINS=

# Secret header value required for admin-only endpoints (POST /scenarios).
# Set to a long random string — treat it like a password.
ADMIN_SECRET=change-me-to-a-long-random-secret
