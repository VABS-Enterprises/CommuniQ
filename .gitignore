# Root level gitignore for CommuniQ monorepo

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log
yarn-error.log

# Environment files
.env
.env.local
*.env
google-services.json
GoogleService-Info.plist

# Dependencies (handled by subproject gitignores)
node_modules/

# Build outputs (handled by subproject gitignores)
build/
dist/
out/

# Temporary files
*.tmp
*.temp
*~
.cache/
