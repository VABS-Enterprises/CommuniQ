<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Production backend (HTTPS — no special config needed, included for clarity) -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">communiq.onrender.com</domain>
  </domain-config>

  <!-- Allow cleartext HTTP to local dev servers only (emulator + LAN) -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">192.168.31.252</domain>
    <domain includeSubdomains="false">192.168.1.5</domain>
  </domain-config>
</network-security-config>
