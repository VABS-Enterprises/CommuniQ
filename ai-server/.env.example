# ============================================================
# CommuniQ AI Server — environment variables
# Copy to .env and fill in values.
# ============================================================
#
# DEFAULT PATH (no GPU, live voice): Groq STT + Groq LLM + Edge TTS
#   ASR_BACKEND=groq  LLM_BACKEND=groq  TTS_BACKEND=edge
#
# Fine-tuning / dataset work is separate (training/). At runtime you only
# point LLM_MODEL (or a hosted API) at the model you want — no local GPU.
# ============================================================

PORT=8000

# ------------------------------------------------------------
# Environment — "development" (default) | "production"
#
# In production, startup validation HARD-FAILS the process if:
#   - AI_SERVER_INTERNAL_KEY is unset/empty
#   - ALLOWED_ORIGINS is unset or "*"
# In development, both are allowed but log a startup warning.
# ------------------------------------------------------------
ENVIRONMENT=development

# ------------------------------------------------------------
# Internal security — shared secret between Node backend and ai-server.
# Required in production. Must match AI_SERVER_INTERNAL_KEY in server/.env.
# Node's fastApiService.js sends this as the X-Ai-Server-Key header.
# ------------------------------------------------------------
AI_SERVER_INTERNAL_KEY=

# ------------------------------------------------------------
# CORS — comma-separated list of allowed origins.
# This is an internal service meant to be called only by the Node backend
# (server-to-server), not a public API — so it does NOT default to "*".
# Leaving this unset denies all browser cross-origin requests.
# In production, set this to the Node backend's actual origin, e.g.:
#   ALLOWED_ORIGINS=https://communiq-backend.onrender.com
# ------------------------------------------------------------
ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Groq — used when ASR_BACKEND=groq and/or LLM_BACKEND=groq
# and/or EVAL_LLM_BACKEND=groq
# https://console.groq.com
# ------------------------------------------------------------
GROQ_API_KEY=

# Model id for conversation turns when LLM_BACKEND=groq
LLM_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------
# Conversation pipeline (live voice)
#
# ASR_BACKEND : groq | local
# LLM_BACKEND : groq | openai_compat | ollama | vllm
# TTS_BACKEND : edge | local
# ------------------------------------------------------------
ASR_BACKEND=groq
LLM_BACKEND=groq
TTS_BACKEND=edge

# ------------------------------------------------------------
# Evaluation (/session/evaluate)
#
# EVAL_LLM_BACKEND : groq | openai_compat | ollama | vllm
# ------------------------------------------------------------
EVAL_LLM_BACKEND=groq
EVAL_LLM_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------
# OpenAI-compatible cloud API
# Use when LLM_BACKEND=openai_compat and/or EVAL_LLM_BACKEND=openai_compat
# (Together, OpenRouter, OpenAI, Fireworks, your hosted vLLM with Bearer auth).
#
# Base URL (no trailing path to /chat/completions):
#   https://api.openai.com
#   https://api.together.xyz/v1
#   https://openrouter.ai/api/v1
#
# Set LLM_MODEL / EVAL_LLM_MODEL to the provider's model string.
# ------------------------------------------------------------
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ------------------------------------------------------------
# Local STT (ASR_BACKEND=local) — optional; needs GPU/CPU + faster-whisper
# ------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------
# Local LLM — Ollama (LLM_BACKEND=ollama)
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------
# Local LLM — vLLM (LLM_BACKEND=vllm) — Linux + CUDA
# ------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ------------------------------------------------------------
# Local TTS (TTS_BACKEND=local)
# ------------------------------------------------------------
KOKORO_VOICE=af_heart
