# ──────────────────────────────────────────────────────────────────────────────
# CommuniQ AI server
#
# QUICK START — one key gets everything working:
#
#   cp .env.example .env
#   # paste your Groq key on the GROQ_API_KEY line below
#   uvicorn app.main:app --port 8000
#
# Every default here is a working configuration. The server validates this file
# at startup and refuses to boot with a clear message if something is missing,
# so you should never have to debug a request to find a config problem.
#
# The same GROQ_API_KEY also goes in pipecat-worker/.env if you run live voice.
# ──────────────────────────────────────────────────────────────────────────────

PORT=8000

# "development" (default) | "production"
# In production, missing security settings below become startup failures
# instead of warnings.
ENVIRONMENT=development

# ── The one key you actually need ─────────────────────────────────────────────
# Get one free at https://console.groq.com/keys — it looks like "gsk_...".
# Required whenever any backend below is set to "groq" (all are, by default).
GROQ_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────────
# Check what your key can reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#
# NOTE: the llama-3.1-* models this file used to name have been retired by
# Groq. Requests for them fail with model_not_found, which took down every
# evaluation and conversation path in the app. Do not put them back.
LLM_MODEL=openai/gpt-oss-20b
EVAL_LLM_MODEL=openai/gpt-oss-20b

# ── Reasoning models ──────────────────────────────────────────────────────────
# The gpt-oss and qwen3 families think before they answer, and that thinking is
# billed against max_tokens. Left alone, a short request spends its whole
# budget reasoning and returns an EMPTY reply with finish_reason="length" —
# which is exactly how roleplay broke: the opening line asked for 80 tokens and
# 78 of them went to the scratchpad.
#
# "low" keeps the thinking to roughly 10-15 tokens, which is what short
# conversational replies need. Raise it if evaluation answers feel shallow.
#   low | medium | high
LLM_REASONING_EFFORT=low

# Minimum token budget for any reasoning-model request, so a caller asking for
# a short reply still leaves room for the thinking that precedes it. Raise this
# if you see "LLM returned no content" with finish=length in the logs.
REASONING_TOKEN_FLOOR=512

# ── Backends ──────────────────────────────────────────────────────────────────
# groq          — Groq cloud (needs GROQ_API_KEY)
# openai_compat — any OpenAI-compatible HTTPS API (OpenAI, Together, OpenRouter)
# ollama        — local Ollama daemon
# vllm          — local vLLM server (Linux + CUDA)
ASR_BACKEND=groq
LLM_BACKEND=groq
EVAL_LLM_BACKEND=groq

# groq | edge | local   — "edge" needs no key and no GPU.
TTS_BACKEND=edge

# ── Internal security ─────────────────────────────────────────────────────────
# Shared secret with the Node backend. When set, every non-health endpoint
# requires the header X-Ai-Server-Key. Must match AI_SERVER_INTERNAL_KEY in
# server/.env. Empty is a warning in development and a hard failure in
# production — this service must never be publicly reachable unauthenticated.
AI_SERVER_INTERNAL_KEY=

# Comma-separated allowed CORS origins, e.g. the Node backend's public URL.
# Empty allows no cross-origin browser requests, which is the right default for
# an internal service. "*" is rejected in production.
ALLOWED_ORIGINS=

# ── Using a non-Groq cloud provider ───────────────────────────────────────────
# Set LLM_BACKEND and/or EVAL_LLM_BACKEND to openai_compat, then fill both of
# these and put the provider's model id in LLM_MODEL / EVAL_LLM_MODEL.
#   https://api.openai.com | https://api.together.xyz/v1 | https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ── Local Whisper (only when ASR_BACKEND=local) ──────────────────────────────
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8

# ── Local LLMs (only when a backend above is ollama or vllm) ─────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── Local TTS (only when TTS_BACKEND=local) ─────────────────────────────────
# af_heart | af_bella | am_adam | bf_emma | bm_george
KOKORO_VOICE=af_heart
